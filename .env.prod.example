# Copy to .env.prod and fill in real secrets, then:
#   docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# PostgreSQL
POSTGRES_USER=billiard
POSTGRES_PASSWORD=change-me-db-password

# Admin account created on first startup (only if no admins exist).
JWT_SECRET=change-me-run-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Shared key between the frontend bundle (VITE_APP_KEY build arg) and the
# backend (FRONTEND_KEY). Generate with:  openssl rand -hex 16
FRONTEND_KEY=change-me-run-openssl-rand-hex-16

# Host port for the frontend nginx (the only exposed service). Defaults to 80.
FRONTEND_PORT=80

# Optional: have the frontend nginx reach the backend at a non-public URL
# instead of the internal compose service (http://backend:3001). Use when the
# backend runs outside this compose network, e.g. a private-network/VPN address
# the host can reach. Defaults to the internal service.
# BACKEND_API_URL=http://192.168.1.50:3001